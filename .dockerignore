# Only the revision refs needed to embed the build commit; exclude Git config,
# history, logs, and hooks from the build context and image.
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs
.git/refs/*
!.git/refs/heads
server/build-commit.json
.codex
.env
server/.env
node_modules
server/node_modules
server/scripts/migration/output
server/data/adopt-review/
server/data/backups/
npm-debug.log*
.DS_Store

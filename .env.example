MONGO_URI=mongodb://127.0.0.1:27017/cmcen
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL_DAYS=30

APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Site configuration access
CONFIG_TOKEN=

# Passkeys and TOTP
RP_NAME=CMCEN
RP_ID=localhost
RP_ORIGIN=http://localhost:3000
TOTP_WINDOW=1
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=300
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_REQUEST_RATE_LIMIT_MAX=5
PASSWORD_RESET_REQUEST_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_EMAIL_RATE_LIMIT_MAX=3
PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_CONFIRM_RATE_LIMIT_MAX=5
MFA_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=300
MFA_VERIFICATION_RATE_LIMIT_MAX=5

# MinIO / S3-compatible object storage
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=cmcen-demo
# Internal S3 endpoint used by the server to upload objects.
MINIO_ENDPOINT=http://127.0.0.1:9000
# Browser-facing S3/CDN origin. The bucket name is appended automatically.
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Public CDN base URL, including the bucket path. Configure this on deployed hosts
# so stored media links never expose an internal storage or Tailscale endpoint.
CDN_PUBLIC_BASE_URL=
CDN_BASE_URL=

# Optional SMTP relay
SMTP_HOST=
SMTP_PORT=25
MAIL_FROM=
MAIL_REPLY_TO=
# Internal branch mailbox monitored by the retirement-submission Power Automate flow.
MAIL_TO_BRANCH=
MAIL_TO_ADMIN=
SEND_EMAIL_ON_RETIREMENT_SUBMISSION=true

# Development-only API documentation
ENABLE_API_DOCS=false



# =============================================================================

# CMCEN / RCMCE Environment Configuration

# =============================================================================

#

# Copy this file to:

#

# server/.env

#

# for local development.

#

# NEVER commit real credentials, passwords, API keys, tokens, private

# infrastructure addresses, or production secrets.

#

# Values in this file are development examples or empty placeholders only.

#

# IMPORTANT:

# Do not place inline comments after environment variable values.

# Keep comments on their own lines.

# =============================================================================

# =============================================================================

# APPLICATION

# =============================================================================

# Runtime environment.

#

# Typical values:

# development

# production

NODE_ENV=development

# HTTP port used by the Express application.

PORT=3000

# Public base URL of this CMCEN instance.

#

# Local:

# http://localhost:3000

#

# Production:

# https://cmcen.example.ca

APP_BASE_URL=http://localhost:3000

# =============================================================================

# MONGODB

# =============================================================================

# MongoDB connection URI.

#

# Local:

# mongodb://127.0.0.1:27017/cmcen

#

# Docker-network example:

# mongodb://mongo:27017/cmcen

#

# Authenticated or managed deployments may use a full connection URI.

MONGO_URI=mongodb://127.0.0.1:27017/cmcen

# =============================================================================

# JWT / SESSION CONFIGURATION

# =============================================================================

# Secret used to sign access, refresh, and temporary authentication tokens.

#

# REQUIRED.

#

# Generate a long cryptographically random value for real deployments.

JWT_SECRET=

# Access-token lifetime.

JWT_ACCESS_TOKEN_TTL=1h

# Refresh-token lifetime in days.

JWT_REFRESH_TOKEN_TTL_DAYS=30

# PASSKEYS / WEBAUTHN / TOTP

# =============================================================================

# Human-readable WebAuthn relying-party name.

RP_NAME=CMCEN

# WebAuthn relying-party ID.

#

# Do NOT include a scheme or path.

#

# Local:

# localhost

#

# Production:

# cmcen.example.ca

RP_ID=localhost

# Exact WebAuthn application origin.

#

# Local:

# http://localhost:3000

#

# Production:

# https://cmcen.example.ca

RP_ORIGIN=http://localhost:3000

# Number of adjacent TOTP time windows accepted during validation.

TOTP_WINDOW=1

# =============================================================================

# RATE LIMITING

# =============================================================================

# General API rate limit.

API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=300

# Password-reset request rate limit by client IP.

PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_REQUEST_RATE_LIMIT_MAX=5

# Password-reset request rate limit by email address.

PASSWORD_RESET_REQUEST_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_EMAIL_RATE_LIMIT_MAX=3

# Password-reset confirmation rate limit.

PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_CONFIRM_RATE_LIMIT_MAX=5

# MFA verification rate limit.

MFA_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=300
MFA_VERIFICATION_RATE_LIMIT_MAX=5

# =============================================================================

# OBJECT STORAGE / MINIO / S3

# =============================================================================

# S3-compatible object-storage access key.

MINIO_ACCESS_KEY=

# S3-compatible object-storage secret key.

MINIO_SECRET_KEY=

# Existing bucket used for uploaded CMCEN media.

MINIO_BUCKET_NAME=cmcen

# Internal S3-compatible endpoint used by the CMCEN server.

#

# Local:

# http://127.0.0.1:9000

#

# Docker-network example:

# http://minio:9000

#

# Remote HTTPS S3-compatible endpoints are also supported.

MINIO_ENDPOINT=http://127.0.0.1:9000

# Browser-accessible S3/MinIO origin.

#

# The bucket name may be appended by the application depending on the public

# media URL path being generated.

#

# Do not expose private Docker, VPN, Tailscale, or internal-only addresses to

# browsers.

#

# If omitted, the application may fall back to MINIO_ENDPOINT.

MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Preferred public media/CDN base URL.

#

# Example:

# https://cdn.example.ca/cmcen

CDN_PUBLIC_BASE_URL=

# Legacy/fallback CDN base URL.

#

# Prefer CDN_PUBLIC_BASE_URL for new deployments.

CDN_BASE_URL=

# =============================================================================

# BOOTSTRAP / DEVELOPMENT ADMIN CONFIGURATION

# =============================================================================

# Administrative bootstrap/development account values.

#

# Leave blank unless the current deployment/bootstrap tooling requires them.

# Do not use weak credentials in staging or production.

ADMIN_USER=
ADMIN_PASSWORD=

# =============================================================================

# SMTP / OUTBOUND EMAIL

# =============================================================================

# SMTP relay hostname.

SMTP_HOST=smtp-relay.gmail.com

# SMTP submission port.

SMTP_PORT=587

# SMTP transport security mode.

#

# Current CMCEN deployments use STARTTLS on port 587.

SMTP_SECURE=starttls

# Require TLS negotiation when implicit TLS is not in use.

SMTP_REQUIRE_TLS=true

# Optional hostname used for the SMTP EHLO/HELO greeting.

#

# Example:

# mail.example.ca

SMTP_HELO_NAME=

# Sender shown to recipients.

#

# Example:

# CMCEN [notifications@example.ca](mailto:notifications@example.ca)

MAIL_FROM=CMCEN [notifications@example.ca](mailto:notifications@example.ca)

# Reply-To address applied to outbound mail.

MAIL_REPLY_TO=[support@example.ca](mailto:support@example.ca)

# =============================================================================

# EMAIL ROUTING

# =============================================================================

# Website errors, system alerts, and technical support.

MAIL_TO_SUPPORT=

# Form submissions and general questions.

MAIL_TO_FORMS=

# Optional CC recipients for form submissions.

#

# Multiple recipients may be comma-separated where supported.

MAIL_CC_FORMS=

# Master of Signals / certificate or branch-specific routing.

MAIL_TO_MOS=

# Generic fallback destination.

MAIL_TO=

# Internal administrative mailbox.

MAIL_TO_ADMIN=

# Set to true to prevent every SMTP delivery while preserving the underlying
# workflow. Use this for safe development and notification testing.
DISABLE_EMAIL_SENDING=false

# Internal branch mailbox for retirement submissions and signed-in contact forms.

MAIL_TO_BRANCH=

# =============================================================================

# CASL / EMAIL SUBSCRIPTIONS

# =============================================================================

# Legal or operating name of the sender.

CASL_SENDER_NAME=

# Physical mailing address of the sender.

CASL_SENDER_MAILING_ADDRESS=

# Contact address or other monitored contact method.

CASL_SENDER_CONTACT=[privacy@example.ca](mailto:privacy@example.ca)

# =============================================================================

# OPTIONAL SELF-HOSTED PLAUSIBLE ANALYTICS

# =============================================================================

# Plausible analytics remain disabled unless BOTH variables below are valid.

# Public CMCEN hostname registered as the site in Plausible.

#

# IMPORTANT:

# This is a hostname/domain only.

#

# Correct:

# cmcen.example.ca

#

# Incorrect:

# https://cmcen.example.ca

PLAUSIBLE_DOMAIN=

# Public browser-accessible Plausible event API URL.

#

# This DOES contain the scheme.

#

# Example:

# https://analytics.example.ca/api/event

PLAUSIBLE_API_URL=

# Optional Plausible shared-dashboard URL for the administrator analytics view.
# Treat this as a secret: anyone with it can view the shared dashboard.
# Example: https://analytics.example.ca/share/cmcen.example.ca?auth=...&embed=true&theme=system
PLAUSIBLE_SHARE_URL=

# =============================================================================

# DEVELOPMENT API DOCUMENTATION

# =============================================================================

# Exposes Swagger/OpenAPI documentation endpoints when set to true.

#

# Keep disabled on public/untrusted deployments unless explicitly required.

ENABLE_API_DOCS=false

# =============================================================================

# BUILD / DEPLOYMENT METADATA

# =============================================================================

#

# The application may read deployment-provided Git commit metadata such as:

#

# COMMIT_SHA

# GIT_COMMIT

# RENDER_GIT_COMMIT

# VERCEL_GIT_COMMIT_SHA

#

# These are normally supplied automatically by CI/deployment infrastructure

# and do not need to be set in server/.env.

# =============================================================================

# Copy this file to .env before running `docker compose up -d`.
# .env is ignored by Git. Do not commit real credentials or secrets.

# Published CMCEN image from the Forgejo package registry. Update this to the
# desired release tag when upgrading.
CMCEN_IMAGE=git.corebot.ca/eric/cmcen-dev:v0.1.0-beta.6

# CMCEN, Garage, and Plausible bind to loopback by default so a reverse proxy can
# provide public HTTPS. Change only when direct public exposure is intentional.
CMCEN_BIND_ADDRESS=127.0.0.1
CMCEN_PORT=3000
GARAGE_BIND_ADDRESS=127.0.0.1
GARAGE_S3_PORT=3900
PLAUSIBLE_BIND_ADDRESS=127.0.0.1
PLAUSIBLE_PORT=8000

# Generate this cluster secret with: openssl rand -hex 32
GARAGE_RPC_SECRET=replace-with-a-64-character-hex-secret

# Garage creates this access key and bucket on first start. CMCEN uses the same
# key to access the bucket. Generate a key ID with: printf 'GK%s\n' "$(openssl rand -hex 16)"
# Generate the secret with: openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=replace-with-a-garage-access-key-id
GARAGE_DEFAULT_SECRET_KEY=replace-with-a-64-character-hex-secret
GARAGE_DEFAULT_BUCKET=cmcen

# Public URL served by the reverse proxy for the Plausible dashboard.
PLAUSIBLE_BASE_URL=https://analytics.example.ca

# Generate a unique secret with: openssl rand -base64 48
PLAUSIBLE_SECRET_KEY_BASE=replace-with-a-long-random-secret
